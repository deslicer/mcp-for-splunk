{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "mcp-server-for-splunk",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name=='mcp-server-for-splunk' || @.name.value=='mcp-server-for-splunk')].version"
        }
      ]
    },
    "packaging/mcp-itsi-server": {
      "release-type": "python",
      "package-name": "mcp-itsi-server",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "component": "mcp-itsi-server",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name=='mcp-itsi-server' || @.name.value=='mcp-itsi-server')].version"
        }
      ]
    }
  }
}
